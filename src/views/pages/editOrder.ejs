<h1>Editar Ordem</h1>

<form action="/orders/update/<%= order.id %>" method="POST">

    <input
        type="text"
        name="problem"
        value="<%= order.problem %>"
    >

    <input
        type="text"
        name="technician"
        value="<%= order.technician %>"
    >

    <select name="priority">

        <option <%= order.priority === 'Baixa' ? 'selected' : '' %>>
            Baixa
        </option>

        <option <%= order.priority === 'Media' ? 'selected' : '' %>>
            Media
        </option>

        <option <%= order.priority === 'Alta' ? 'selected' : '' %>>
            Alta
        </option>

    </select>

    <button type="submit">
        Salvar
    </button>

</form>